# ── Arbitrum Sepolia deploy env for Deploy.s.sol + DeployTestnetMocks.s.sol ──
# Copy to `.env` (forge auto-loads .env from the package root):
#     cp .env.sepolia.example .env
# Then fill the values and run the runbook (context/SEPOLIA_DEPLOY_RUNBOOK.md).

# Deployer / owner key — funded with Arbitrum Sepolia ETH for gas.
# Faucet: https://faucets.chain.link/arbitrum-sepolia
DEPLOYER_PRIVATE_KEY=0x

# RPC. Public works; Alchemy/Infura more reliable for --broadcast.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Roles (Deploy.s.sol) ────────────────────────────────────────────────────
# Relayer = the off-chain matching/resolver service wallet (authorized on the
# resolver + set as the cycler forwarder). Treasury = receives platform fee +
# funds rebate claims. May equal the deployer for a throwaway testnet bring-up.
RELAYER_ADDRESS=0x
TREASURY_ADDRESS=0x

# ── Collateral + strike feeds (from DeployTestnetMocks.s.sol output) ─────────
# Run DeployTestnetMocks.s.sol FIRST, then paste its printed addresses here.
USDT_ADDRESS=0x
CHAINLINK_BTC_USD_FEED=0x
CHAINLINK_ETH_USD_FEED=0x
CHAINLINK_SEQUENCER_FEED=0x

# ── Chainlink Data Streams (REAL DON path) ──────────────────────────────────
# VerifierProxy on Arbitrum Sepolia (confirmed against Chainlink docs 2026-06):
CHAINLINK_VERIFIER_PROXY_ADDRESS=0x2ff010DEbC1297f19579B4246cad07bd24F2488A
# LINK token on Arbitrum Sepolia — fill from
# https://docs.chain.link/resources/link-token-contracts (Arbitrum Sepolia row).
# Resolver holds its own LINK for verify fees; fund it post-deploy.
CHAINLINK_LINK_TOKEN_ADDRESS=0x

# Optional migration mode: reuse an existing Settlement, redeploy only
# Resolver + AutoCycler against it (deployer must be the Settlement owner).
# EXISTING_SETTLEMENT_ADDRESS=0x

# ── Data Streams feed IDs (NOT read by Deploy.s.sol; used post-deploy via
#    resolver.configureStreamsFeed + by the backend dev-keeper/resolver). ─────
# These MUST be the stream IDs your resolver address is allow-listed for on the
# Chainlink DON. See https://docs.chain.link/data-streams/stream-ids
# ETH/USD (Arbitrum Sepolia testnet, confirmed 2026-06):
STREAMS_FEED_ID_ETH_USD=0x000359843a543ee2fe414dc14c7e7920ef10f4372990b79d6361cdc0dd1ba782
# BTC/USD (Arbitrum Sepolia testnet) — fill from the stream-ids page:
STREAMS_FEED_ID_BTC_USD=0x

# Optional Arbiscan verification of deployed contracts.
# ARBISCAN_API_KEY=
