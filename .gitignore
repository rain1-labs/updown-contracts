# Environment — ignore every .env variant, keep the committed *.example templates.
# Without the wildcard, `.env.dev` / `.env.prod` are NOT ignored and a filled-in
# file would commit a live private key.
.env
.env.*
!.env.*.example

# Dependencies
node_modules/

# Foundry build output
out/
cache/
lib/

# Hardhat build output
cache_hardhat/
artifacts/
typechain/
typechain-types/

# Foundry broadcast / deploy logs (contain tx hashes + addresses, commit if you want a record)
broadcast/

# OS
.DS_Store
Thumbs.db

# Lock files
package-lock.json
yarn.lock
foundry.lock

docs/csco-reports/
audit-repro/