# ─────────────────────────────────────────────────────────────────────────────
# DEV environment — Arbitrum One (chainId 42161), mock-DON path
#
#   cp .env.dev.example .env.dev
#   npm run simulate:dev      # dry run, no broadcast — always do this first
#   npm run deploy:dev
#
# NOTE: dev is NOT on a testnet. It is a real Arbitrum One deployment against a
# valueless dev-USDT token and a MOCK Data Streams verifier. Deploys cost real
# ETH. Nothing in the current dev or prod stack runs on Sepolia.
#
# DEPLOY_LABEL is not set here — the npm targets pass it inline (dev/prod) to
# name the deployments/<label>-<block>.json record. Invoking `forge script`
# by hand without it writes `unlabeled-<block>.json`.
#
# Every non-secret value below was read off the live dev contracts on
# 2026-08-10 and was the exact config the deployment ran with. Deploying from
# this file reproduced dev like-for-like: Settlement, Resolver and AutoCycler
# all logic-identical to the live deployment (zero residual diffs with
# immutables + metadata masked), re-verified after the 9a7b3d8 formatting pass.
#
# ONE EXCEPTION as of 2026-08-13 — STREAMS_FEED_ID_BTC_USD / _ETH_USD below no
# longer match the live dev resolver. They now carry a 0x0002 schema prefix for
# the TWAP rehearsal, while the deployed resolver still holds the original
# 0xbb1d… / 0xcb73… ids. Those two lines describe the state this file deploys
# TOWARD, not the state currently on chain, and they stay divergent until the
# dev Resolver + AutoCycler are redeployed. Everything else still mirrors live.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets — GENERATE FRESH, never reuse the previous developer's keys ──────
# 0x-prefixed hex. Deploy.s.sol reads this with vm.envUint, so the 0x is
# required. This key becomes the initial owner of all three contracts; hand
# ownership off afterwards (see OWNER_ADDRESS below).
# Fund it with ETH on Arbitrum One before deploying.
DEPLOYER_PRIVATE_KEY=0x

ARBITRUM_RPC_URL=
ARBISCAN_API_KEY=

# ── Roles — GENERATE FRESH ──────────────────────────────────────────────────
# Relayer: hot key held by the backend; submits enterPosition / mint / redeemFor.
RELAYER_ADDRESS=0x
# Treasury: receives platformFee and funds rebate claims. Must be non-zero —
# any fill with platformFee > 0 reverts TreasuryNotConfigured.
# The old dev setup pointed this at the owner EOA; splitting them is cleaner.
TREASURY_ADDRESS=0x

# ── Collateral + feeds (live dev values, carry over unchanged) ───────────────
# Dev USDT — publicly mintable, valueless.
USDT_ADDRESS=0xCa4f77A38d8552Dd1D5E44e890173921B67725F4

# MOCK Data Streams verifier (src/mocks/MockVerifierProxy.sol). Stateless, no
# owner, no LINK, no Chainlink account needed — the off-chain report producer
# lives in the backend under STREAMS_MOCK=1.
#
# The existing mock at the address below is ownerless and its EXECUTABLE bytecode
# still matches this tree exactly, so it is safe to reuse as-is. Its source
# metadata hash no longer matches (the 9a7b3d8 formatting pass), so that deployed
# instance is not Arbiscan-verifiable from current source. Harmless for a
# stateless dev mock. Redeploy if you want a clean, verifiable one:
#   npm run mockdon:dev
# (USDT_ADDRESS is set below, so it reuses the dev USDT instead of minting a new one)
CHAINLINK_VERIFIER_PROXY_ADDRESS=0x9c8BA5dE25aB2fd183704c354Edf118fa3dA81b4

# Real Arbitrum One Chainlink addresses — dev mocks only the Streams verifier.
CHAINLINK_LINK_TOKEN_ADDRESS=0xf97f4df75117a78c1A5a0DBb814Af92458539FB4
CHAINLINK_BTC_USD_FEED=0x6ce185860a4963106506C203335A2910413708e9
CHAINLINK_ETH_USD_FEED=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612
CHAINLINK_SEQUENCER_FEED=0xFdB631F5EE196F0ed6FAa767959853A9F217697D

# ── Migration mode — SET for a Resolver/AutoCycler upgrade ──────────────────
# Skips the Settlement deploy and redeploys only Resolver + AutoCycler, then
# rewires the existing Settlement via setResolver/setAutocycler. Markets and
# balances stay put.
#
# SET IT   when changing resolver or cycler logic. This is the normal upgrade.
# UNSET IT only when rotating away from an owner key you no longer trust —
#          that case wants a fresh Settlement, since the old owner keeps
#          proposeEmergencyWithdraw over the old one.
#
# Dev collateral is valueless dev-USDT, so a fresh deploy here costs nothing
# but the addresses. Keeping dev on the same migration path as prod is the
# point: rehearse the upgrade here first and prod holds no surprises.
#
# Before deploying, run the preflight (same script, dev env):
#   set -a && . ./.env.dev && set +a && \
#     forge script script/UpgradePreflight.s.sol --rpc-url "$ARBITRUM_RPC_URL"
#
# The address below is the live dev Settlement as of 2026-08-13, matching
# deployments/dev-25724115.json and confirmed against chain. Its owner is
# 0x1B4320cCe93468fBFEF1d4Ed483b1F80ad326E6a — your DEPLOYER_PRIVATE_KEY must
# resolve to that address or the deploy reverts mid-broadcast.
EXISTING_SETTLEMENT_ADDRESS=0x8EA9Cdc4dC1A5E109820151CB95be4c76bd055F4

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOY-TIME — read by Deploy.s.sol inside the broadcast
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Mock-DON stream IDs currently configured on the live dev resolver.
# Deploy.s.sol calls configureStreamsFeed for both pairs during the deploy; an
# unset value aborts before anything is broadcast. Do NOT leave these blank
# intending to apply them by hand — see the header note on why a resolver with
# no Streams config opens markets it can never settle.
# These are arbitrary mock IDs — no Chainlink DON allow-list is involved on dev.
# TWAP rehearsal (2026-08-13): these now carry a 0x0002 schema prefix so dev
# exercises the same v2 decode path prod will run against Chainlink's TWAP
# streams. configureStreamsFeed rejects any other prefix on-chain, so the old
# bare ids (0xbb1d…, 0xcb73…) can no longer be configured at all. The backend's
# STREAMS_MOCK producer reads the same prefix and emits a 7-word ReportV2 to
# match; changing one without the other yields UnexpectedReportLength.
STREAMS_FEED_ID_BTC_USD=0x0002cde9a369303bd96ba838cd93d32905e38480cc6804a502641c73d9a138e3
STREAMS_FEED_ID_ETH_USD=0x000209d98a8115cb634bdf3426c4cd5297fdfd094e7742b5d0739cbf00df951c

# Optional. Cycler forwarder, applied by Deploy.s.sol. Defaults to
# RELAYER_ADDRESS when blank, which matches how dev has always run (one wallet
# for both relayer and keeper). Set it only if you split the keeper out.
KEEPER_FORWARDER_ADDRESS=

# Optional. Cycler pre-listing window, applied by Deploy.s.sol. Defaults to 300,
# matching both live deployments. The contract's own default is 0 and the
# constructor does not set it, so this exists to stop a fresh deploy from
# silently regressing. Max 300 (PRE_START_WINDOW_MAX); leave blank unless you
# have a reason.
# PRE_START_WINDOW_SEC=300

# Optional. Final owner, transferred by Deploy.s.sol as its last broadcast step.
# Ownable2Step, so this only sets pendingOwner — the target must then call
# acceptOwnership, and a wrong address cannot lock you out. Left blank, the
# deployer key stays owner and the script warns. A Safe is overkill for dev;
# a cold EOA you control is fine.
OWNER_ADDRESS=0x

# ─────────────────────────────────────────────────────────────────────────────
# POST-DEPLOY — nothing to configure here
# ─────────────────────────────────────────────────────────────────────────────
# The deploy prints the three `cast send <addr> 'acceptOwnership()'` commands
# with the correct addresses, and writes them to
# deployments/dev-<block>.json. Run them from OWNER_ADDRESS to complete the
# Ownable2Step handoff — no env entry needed, and no third copy of the
# addresses to drift out of date.
#
# Funding test wallets with dev-USDT is a manual `cast send` — see
# docs/operations.md. Deliberately not wired into an npm target so the mint
# authority key never gets sourced into a deploy shell.
