# ─────────────────────────────────────────────────────────────────────────────
# DEV environment — Arbitrum One (chainId 42161), mock-DON path
#
#   cp .env.dev.example .env.dev
#
# NOTE: dev is NOT on a testnet. It is a real Arbitrum One deployment against a
# valueless dev-USDT token and a MOCK Data Streams verifier. Deploys cost real
# ETH. Ignore `.env.sepolia.example` — nothing in the current dev or prod stack
# runs on Sepolia.
#
# Every non-secret value below was read off the live dev contracts on
# 2026-08-10 and is the exact config the current deployment runs with.
# Deploying from this file reproduces dev like-for-like: the deployed bytecode
# is byte-identical to this branch (audit/hacken-remediation-v2 @ 274331d)
# after masking immutables + metadata.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets — GENERATE FRESH, never reuse the previous developer's keys ──────
# 0x-prefixed hex. Deploy.s.sol reads this with vm.envUint, so the 0x is
# required. This key becomes the initial owner of all three contracts; hand
# ownership off afterwards (see OWNER_ADDRESS below).
# Fund it with ETH on Arbitrum One before deploying.
DEPLOYER_PRIVATE_KEY=0x

ARBITRUM_RPC_URL=
ARBISCAN_API_KEY=

# ── Roles — GENERATE FRESH ──────────────────────────────────────────────────
# Relayer: hot key held by the backend; submits enterPosition / mint / redeemFor.
RELAYER_ADDRESS=0x
# Treasury: receives platformFee and funds rebate claims. Must be non-zero —
# any fill with platformFee > 0 reverts TreasuryNotConfigured.
# The old dev setup pointed this at the owner EOA; splitting them is cleaner.
TREASURY_ADDRESS=0x

# ── Collateral + feeds (live dev values, carry over unchanged) ───────────────
# Dev USDT — publicly mintable, valueless.
USDT_ADDRESS=0xCa4f77A38d8552Dd1D5E44e890173921B67725F4

# MOCK Data Streams verifier (src/mocks/MockVerifierProxy.sol). Stateless, no
# owner, no LINK, no Chainlink account needed — the off-chain report producer
# lives in the backend under STREAMS_MOCK=1.
#
# The existing mock at the address below is byte-identical to this branch's
# build and is ownerless, so it is safe to reuse as-is. Redeploy it only if you
# want a clean slate:
#   forge script script/DeployMockDon.s.sol --rpc-url $ARBITRUM_RPC_URL --broadcast
# (with USDT_ADDRESS set, so it reuses the dev USDT instead of minting a new one)
CHAINLINK_VERIFIER_PROXY_ADDRESS=0x9c8BA5dE25aB2fd183704c354Edf118fa3dA81b4

# Real Arbitrum One Chainlink addresses — dev mocks only the Streams verifier.
CHAINLINK_LINK_TOKEN_ADDRESS=0xf97f4df75117a78c1A5a0DBb814Af92458539FB4
CHAINLINK_BTC_USD_FEED=0x6ce185860a4963106506C203335A2910413708e9
CHAINLINK_ETH_USD_FEED=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612
CHAINLINK_SEQUENCER_FEED=0xFdB631F5EE196F0ed6FAa767959853A9F217697D

# ── Migration mode — LEAVE UNSET ────────────────────────────────────────────
# Setting this preserves the OLD Settlement, which is the opposite of a key
# rotation: the previous owner keeps full control of it. Fresh deploy only.
# EXISTING_SETTLEMENT_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# POST-DEPLOY — not read by Deploy.s.sol; applied by hand afterwards
# ─────────────────────────────────────────────────────────────────────────────

# Mock-DON stream IDs currently configured on the live dev resolver. Re-apply
# to the new resolver:
#   cast send $RESOLVER "configureStreamsFeed(bytes32,bytes32)" $(cast keccak "BTC/USD") $STREAMS_FEED_ID_BTC_USD
#   cast send $RESOLVER "configureStreamsFeed(bytes32,bytes32)" $(cast keccak "ETH/USD") $STREAMS_FEED_ID_ETH_USD
# These are arbitrary mock IDs — no Chainlink DON allow-list is involved on dev.
STREAMS_FEED_ID_BTC_USD=0xbb1dcde9a369303bd96ba838cd93d32905e38480cc6804a502641c73d9a138e3
STREAMS_FEED_ID_ETH_USD=0xcb7309d98a8115cb634bdf3426c4cd5297fdfd094e7742b5d0739cbf00df951c

# Deploy.s.sol sets cycler.forwarder = RELAYER_ADDRESS. The old dev env ran the
# keeper from the relayer key too, so leave this equal to RELAYER_ADDRESS unless
# you are splitting the keeper out. If you split it:
#   cast send $CYCLER "setForwarder(address)" $KEEPER_FORWARDER_ADDRESS
KEEPER_FORWARDER_ADDRESS=

# Final owner. Deploy.s.sol transfers to this as its last broadcast step when
# set (Ownable2Step, so it only sets pendingOwner — the target must then call
# acceptOwnership). A Safe is overkill for dev; a cold EOA you control is fine.
OWNER_ADDRESS=0x
# Key for OWNER_ADDRESS — used by `npm run accept-ownership:dev` and any
# owner-gated ops target. Keep distinct from DEPLOYER_PRIVATE_KEY.
OWNER_PRIVATE_KEY=0x

# ── Ops targets (npm run …) — fill in AFTER the deploy ──────────────────────
# Copy these from the deployments/dev-<block>.json record the deploy writes.
SETTLEMENT_ADDRESS=
RESOLVER_ADDRESS=
CYCLER_ADDRESS=

# Dev-USDT mint authority (0xAff5289591653038340645FDc1e1Ed3a3B52E436). This is
# a DIFFERENT key from the deployer — mint() on the dev USDT is owner-gated, not
# permissionless, so reusing DEPLOYER_PRIVATE_KEY here reverts
# OwnableUnauthorizedAccount. Used by `npm run usdt:mint` / `usdt:send`.
# The minter already holds ~10^13 USDTm, so `usdt:send` is usually enough and
# no minting is needed.
MINTER_PRIVATE_KEY=0x
MINT_RECIPIENT=
MINT_AMOUNT=5000000000

# ─────────────────────────────────────────────────────────────────────────────
# SUPERSEDED — not part of the deploy
# ─────────────────────────────────────────────────────────────────────────────
# ThinWalletFactory is ownerless and permissionless, so the previous developer's
# keys have no power over it — there is nothing to rotate. The popup-less
# order-session flow shipped on rain.trade's Alchemy Modular Account v2 instead
# (see test/OrderSessionForkTest.t.sol), and all 15 wallets the dev factory ever
# deployed hold zero balance and zero allowance. Do not redeploy: a new factory
# changes every user's CREATE2 address. Keep pointing the backend /config at the
# existing one if anything still reads it.
# THIN_WALLET_FACTORY_ADDRESS=0xcACad301F7Fd5E180794D1fD06e9a88A2be4bFd2

# ─────────────────────────────────────────────────────────────────────────────
# OUTGOING DEPLOYMENT — for the cutover/drain, not for Deploy.s.sol
# ─────────────────────────────────────────────────────────────────────────────
# Held 2,394.81 dev-USDT and 10,530 markets as of 2026-08-10. The previous
# owner retains full control of these contracts forever; redeploying does not
# change that. Drain and quiesce before cutting over.
#   OLD_SETTLEMENT=0x9d1298C0124E0DF23c0DeD9121E530Fb7269c9CE
#   OLD_RESOLVER=0xCe53c30c95b58fD01145159A889e9D2Ae613837d
#   OLD_CYCLER=0x4997a2a31a9c597a00ad6aecf2b4263562c65c12
#   OLD_OWNER/TREASURY=0x95E17677e3d51690e1242220eBa071F1d683f35F
#   OLD_RELAYER/FORWARDER=0xaE5AE6630f2C864E488528b4Df742008352DD258  (EIP-7702
#     delegated to 0x63c0c19a282a1b52b07dd5a65b58948a07dae32b)
